<kml xmlns="http://www.opengis.net/kml/2.2"><Document><name>Thailand itinerary 2026 — primary places</name><Style id="bangkok-city"><IconStyle><color>ff4080ff</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/red-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff4080ff</color></LabelStyle></Style><Style id="bangkok-hotel"><IconStyle><color>ff00d5ff</color><scale>1.25</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff00d5ff</color></LabelStyle></Style><Style id="bangkok-alternative"><IconStyle><color>ff808080</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/grn-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff808080</color></LabelStyle></Style><Style id="phuket-city"><IconStyle><color>ff40a060</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/red-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff40a060</color></LabelStyle></Style><Style id="phuket-hotel"><IconStyle><color>ff00d5ff</color><scale>1.25</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff00d5ff</color></LabelStyle></Style><Style id="phuket-alternative"><IconStyle><color>ff808080</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/grn-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff808080</color></LabelStyle></Style><Style id="kuala-lumpur-city"><IconStyle><color>ffff8040</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/red-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ffff8040</color></LabelStyle></Style><Style id="kuala-lumpur-hotel"><IconStyle><color>ff00d5ff</color><scale>1.25</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff00d5ff</color></LabelStyle></Style><Style id="kuala-lumpur-alternative"><IconStyle><color>ff808080</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/grn-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff808080</color></LabelStyle></Style><Style id="tashkent-city"><IconStyle><color>ffb040a0</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/red-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ffb040a0</color></LabelStyle></Style><Style id="tashkent-hotel"><IconStyle><color>ff00d5ff</color><scale>1.25</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff00d5ff</color></LabelStyle></Style><Style id="tashkent-alternative"><IconStyle><color>ff808080</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/grn-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff808080</color></LabelStyle></Style><Style id="sochi-and-transit-city"><IconStyle><color>ff40c0d0</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/red-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff40c0d0</color></LabelStyle></Style><Style id="sochi-and-transit-hotel"><IconStyle><color>ff00d5ff</color><scale>1.25</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff00d5ff</color></LabelStyle></Style><Style id="sochi-and-transit-alternative"><IconStyle><color>ff808080</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/grn-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff808080</color></LabelStyle></Style><Placemark><name>INNSiDE by Meliá Bangkok Sukhumvit On Nut</name><styleUrl>#bangkok-hotel</styleUrl><description>&lt;div&gt;&lt;b&gt;INNSiDE by Meliá Bangkok Sukhumvit On Nut&lt;/b&gt;&lt;br&gt;Bangkok · 15, 16, 17 ноября&lt;br&gt;&lt;br&gt;Наш отель на 15–17 ноября; выезд 17 ноября. База в On Nut, Бангкок&lt;/div&gt;</description><Point><coordinates>100.59999800000001,13.707056999999999,0</coordinates></Point></Placemark><Placemark><name>Ramada Plaza by Wyndham Bangkok Sukhumvit 48</name><styleUrl>#bangkok-hotel</styleUrl><description>&lt;div&gt;&lt;b&gt;Ramada Plaza by Wyndham Bangkok Sukhumvit 48&lt;/b&gt;&lt;br&gt;Bangkok · 14, 15 ноября&lt;br&gt;&lt;br&gt;Наш отель на 14–15 ноября; выезд 15 ноября. База на Sukhumvit 48 в Бангкоке&lt;/div&gt;</description><Point><coordinates>100.598947,13.709149499999999,0</coordinates></Point></Placemark><Placemark><name>Erawan Museum, Samut Prakan</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Erawan Museum, Samut Prakan&lt;/b&gt;&lt;br&gt;Bangkok · 14 ноября&lt;br&gt;&lt;br&gt;Необязательный музей в позднее утро прилёта, если есть силы&lt;/div&gt;</description><Point><coordinates>100.5891382,13.629975499999995,0</coordinates></Point></Placemark><Placemark><name>Amora Beach Resort Phuket</name><styleUrl>#phuket-hotel</styleUrl><description>&lt;div&gt;&lt;b&gt;Amora Beach Resort Phuket&lt;/b&gt;&lt;br&gt;Phuket · 19, 20, 21, 22, 23, 24, 25, 26, 27 ноября&lt;br&gt;&lt;br&gt;Наш отель по брони на 19–27 ноября; выезд 27 ноября. База у Bang Tao Beach. Фактически 21–22 ноября ночуем в Куала-Лумпуре в ExpressionZ; условия сохранения номера Amora на это время отдельно не подтверждены&lt;/div&gt;</description><Point><coordinates>98.2924771,7.991300099999999,0</coordinates></Point></Placemark><Placemark><name>Wyndham Garden Naithon Phuket</name><styleUrl>#phuket-hotel</styleUrl><description>&lt;div&gt;&lt;b&gt;Wyndham Garden Naithon Phuket&lt;/b&gt;&lt;br&gt;Phuket · 17, 18, 19 ноября&lt;br&gt;&lt;br&gt;Наш отель на 17–19 ноября; выезд 19 ноября. База у Naithon Beach на севере Пхукета&lt;/div&gt;</description><Point><coordinates>98.2798151,8.0585329,0</coordinates></Point></Placemark><Placemark><name>У Аэропорта · Молдовка, Сочи</name><styleUrl>#sochi-and-transit-hotel</styleUrl><description>&lt;div&gt;&lt;b&gt;У Аэропорта · Молдовка, Сочи&lt;/b&gt;&lt;br&gt;Sochi and Transit · 12, 13 ноября&lt;br&gt;&lt;br&gt;Наш отель забронирован на 12–13 ноября; поезд прибывает утром 13-го. Нужен короткий утренний отдых после дороги; заранее получить подтверждение отеля, что номер сохранят до приезда, несмотря на ночную неявку&lt;/div&gt;</description><Point><coordinates>39.952,43.455502,0</coordinates></Point></Placemark><Placemark><name>Bangkok Art and Culture Centre</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Bangkok Art and Culture Centre&lt;/b&gt;&lt;br&gt;Bangkok · 17 ноября&lt;br&gt;&lt;br&gt;Короткий выставочный визит перед Stolen Sala во вторник&lt;/div&gt;</description><Point><coordinates>100.53021679999999,13.746733899999999,0</coordinates></Point></Placemark><Placemark><name>Get Back and Jude Records</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Get Back and Jude Records&lt;/b&gt;&lt;br&gt;Bangkok · 16 ноября&lt;br&gt;&lt;br&gt;Винил в Chinatown по пути к Jeen и Song Wat&lt;/div&gt;</description><Point><coordinates>100.50756659999999,13.7384249,0</coordinates></Point></Placemark><Placemark><name>Hidden Bangkok Bistro</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Hidden Bangkok Bistro&lt;/b&gt;&lt;br&gt;Bangkok · 15 ноября&lt;br&gt;&lt;br&gt;Обед у канала с видом на Будду и красным автоматом открыток&lt;/div&gt;</description><Point><coordinates>100.4719368,13.721551400000001,0</coordinates></Point></Placemark><Placemark><name>Jeen Coffee Bar: Song Sawat</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Jeen Coffee Bar: Song Sawat&lt;/b&gt;&lt;br&gt;Bangkok · 16 ноября&lt;br&gt;&lt;br&gt;Кофе и красный автомат мини-открыток по пути&lt;/div&gt;</description><Point><coordinates>100.51118249999999,13.7388002,0</coordinates></Point></Placemark><Placemark><name>Mitr Street Tha Tien</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Mitr Street Tha Tien&lt;/b&gt;&lt;br&gt;Bangkok · 15 ноября&lt;br&gt;&lt;br&gt;Ранний ужин после Wat Pho с видом на этот храм&lt;/div&gt;</description><Point><coordinates>100.4916286,13.745205299999999,0</coordinates></Point></Placemark><Placemark><name>Nai Ek Roll Noodles</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Nai Ek Roll Noodles&lt;/b&gt;&lt;br&gt;Bangkok · 16 ноября&lt;br&gt;&lt;br&gt;Постоянная лапшичная вместо обещания всех понедельничных тележек&lt;/div&gt;</description><Point><coordinates>100.5099369,13.7401053,0</coordinates></Point></Placemark><Placemark><name>Saen Saep: общественный катер</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Saen Saep: общественный катер&lt;/b&gt;&lt;br&gt;Bangkok · 16 ноября&lt;br&gt;&lt;br&gt;Короткий дешёвый городской канал Hua Chang → Pratunam перед centralwOrld&lt;/div&gt;</description><Point><coordinates>100.53071849999999,13.749193499999999,0</coordinates></Point></Placemark><Placemark><name>Song Wat Road</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Song Wat Road&lt;/b&gt;&lt;br&gt;Bangkok · 16 ноября&lt;br&gt;&lt;br&gt;Фасады и переулки до темноты по дороге от винила к Yaowarat&lt;/div&gt;</description><Point><coordinates>100.5089791,13.7373132,0</coordinates></Point></Placemark><Placemark><name>Stolen Sala</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Stolen Sala&lt;/b&gt;&lt;br&gt;Bangkok · 17 ноября&lt;br&gt;&lt;br&gt;Фиксированный обед 17-го и дневной вид на BTS&lt;/div&gt;</description><Point><coordinates>100.54621639999999,13.7432927,0</coordinates></Point></Placemark><Placemark><name>TAY Song Wat: возможный автомат мини-открыток</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;TAY Song Wat: возможный автомат мини-открыток&lt;/b&gt;&lt;br&gt;Bangkok · 16 ноября&lt;br&gt;&lt;br&gt;Необязательная проверка автомата по дороге Song Wat&lt;/div&gt;</description><Point><coordinates>100.5087166,13.7374619,0</coordinates></Point></Placemark><Placemark><name>Unculture Silom Rooftop Bar</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Unculture Silom Rooftop Bar&lt;/b&gt;&lt;br&gt;Bangkok · 14 ноября&lt;br&gt;&lt;br&gt;Возможный вечер огней после отдыха, не обязательный закат&lt;/div&gt;</description><Point><coordinates>100.5280185,13.7256334,0</coordinates></Point></Placemark><Placemark><name>Wat Arun</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Wat Arun&lt;/b&gt;&lt;br&gt;Bangkok · 15 ноября&lt;br&gt;&lt;br&gt;Фарфоровые детали прангов перед короткой переправой к Tha Tien&lt;/div&gt;</description><Point><coordinates>100.488444,13.743865200000002,0</coordinates></Point></Placemark><Placemark><name>Wat Paknam Phasi Charoen</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Wat Paknam Phasi Charoen&lt;/b&gt;&lt;br&gt;Bangkok · 15 ноября&lt;br&gt;&lt;br&gt;Полноценное посещение храма, а не только вид на Будду с воды&lt;/div&gt;</description><Point><coordinates>100.47035679999999,13.721791800000002,0</coordinates></Point></Placemark><Placemark><name>Wat Pho</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Wat Pho&lt;/b&gt;&lt;br&gt;Bangkok · 15 ноября&lt;br&gt;&lt;br&gt;Лежащий Будда и дворы; музейный зал условно внутри этого визита&lt;/div&gt;</description><Point><coordinates>100.4927733,13.746423700000001,0</coordinates></Point></Placemark><Placemark><name>Yaowarat / Chinatown: вечерняя прогулка</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Yaowarat / Chinatown: вечерняя прогулка&lt;/b&gt;&lt;br&gt;Bangkok · 16 ноября&lt;br&gt;&lt;br&gt;Вечерний неон Chinatown после Song Wat&lt;/div&gt;</description><Point><coordinates>100.5086601,13.7408333,0</coordinates></Point></Placemark><Placemark><name>centralwOrld: Uniqlo + Zara</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;centralwOrld: Uniqlo + Zara&lt;/b&gt;&lt;br&gt;Bangkok · 16 ноября&lt;br&gt;&lt;br&gt;Один ТЦ с нужными Uniqlo и Zara без лишней смены районов&lt;/div&gt;</description><Point><coordinates>100.53914879999999,13.746533699999999,0</coordinates></Point></Placemark><Placemark><name>Ват Самфран («храм с драконом»)</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Ват Самфран («храм с драконом»)&lt;/b&gt;&lt;br&gt;Bangkok · 15 ноября&lt;br&gt;&lt;br&gt;Обязательный храм дракона 15 ноября, 09:00–10:15; затем на машине к Wat Paknam&lt;/div&gt;</description><Point><coordinates>100.2153441,13.7358272,0</coordinates></Point></Placemark><Placemark><name>Музейный зал внутри Wat Pho</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Музейный зал внутри Wat Pho&lt;/b&gt;&lt;br&gt;Bangkok · 15 ноября&lt;br&gt;&lt;br&gt;Внутрихрамовый зал Wat Pho; использовать координаты комплекса Wat Pho&lt;/div&gt;</description><Point><coordinates>100.4927733,13.746423700000001,0</coordinates></Point></Placemark><Placemark><name>Bangunan Sultan Abdul Samad</name><styleUrl>#kuala-lumpur-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Bangunan Sultan Abdul Samad&lt;/b&gt;&lt;br&gt;Kuala Lumpur · 22 ноября&lt;br&gt;&lt;br&gt;Утренний фасад и часы снаружи, внутренний доступ не обещается&lt;/div&gt;</description><Point><coordinates>101.6944582,3.1487179,0</coordinates></Point></Placemark><Placemark><name>Chinatown 1974</name><styleUrl>#kuala-lumpur-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Chinatown 1974&lt;/b&gt;&lt;br&gt;Kuala Lumpur · 22 ноября&lt;br&gt;&lt;br&gt;Выбранный комплекс на Jalan Petaling, не гарантия всех этажей до полудня&lt;/div&gt;</description><Point><coordinates>101.6982118,3.1411130999999997,0</coordinates></Point></Placemark><Placemark><name>ExpressionZ Professional Suites KLCC</name><styleUrl>#kuala-lumpur-hotel</styleUrl><description>&lt;div&gt;&lt;b&gt;ExpressionZ Professional Suites KLCC&lt;/b&gt;&lt;br&gt;Kuala Lumpur · 21, 22 ноября&lt;br&gt;&lt;br&gt;Наше размещение в Куала-Лумпуре на 21–22 ноября; выезд 22 ноября. База в районе KLCC&lt;/div&gt;</description><Point><coordinates>101.7124307,3.1716283,0</coordinates></Point></Placemark><Placemark><name>Ho Kow Hainam Kopitiam: 1 Jalan Balai Polis</name><styleUrl>#kuala-lumpur-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Ho Kow Hainam Kopitiam: 1 Jalan Balai Polis&lt;/b&gt;&lt;br&gt;Kuala Lumpur · 22 ноября&lt;br&gt;&lt;br&gt;Резервный короткий обед только без длинной очереди&lt;/div&gt;</description><Point><coordinates>101.697722,3.1413142,0</coordinates></Point></Placemark><Placemark><name>Jalan Alor</name><styleUrl>#kuala-lumpur-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Jalan Alor&lt;/b&gt;&lt;br&gt;Kuala Lumpur · 21 ноября&lt;br&gt;&lt;br&gt;Ранний ужин на выбранной улице еды&lt;/div&gt;</description><Point><coordinates>101.7092327,3.1462092000000004,0</coordinates></Point></Placemark><Placemark><name>Kwai Chai Hong</name><styleUrl>#kuala-lumpur-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Kwai Chai Hong&lt;/b&gt;&lt;br&gt;Kuala Lumpur · 22 ноября&lt;br&gt;&lt;br&gt;Мостик, арки и один-два мурала в компактном утреннем кластере&lt;/div&gt;</description><Point><coordinates>101.6976131,3.1414714999999998,0</coordinates></Point></Placemark><Placemark><name>Petronas Twin Towers: наружные виды / Lake Symphony</name><styleUrl>#kuala-lumpur-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Petronas Twin Towers: наружные виды / Lake Symphony&lt;/b&gt;&lt;br&gt;Kuala Lumpur · 21 ноября&lt;br&gt;&lt;br&gt;Наружные башни и однозначный слот фонтана 20:00–20:10&lt;/div&gt;</description><Point><coordinates>101.7115639,3.1574693,0</coordinates></Point></Placemark><Placemark><name>Sri Maha Mariamman Temple: Chinatown, Jalan Tun H.S. Lee</name><styleUrl>#kuala-lumpur-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Sri Maha Mariamman Temple: Chinatown, Jalan Tun H.S. Lee&lt;/b&gt;&lt;br&gt;Kuala Lumpur · 22 ноября&lt;br&gt;&lt;br&gt;Именно храм Jalan Tun H.S. Lee, до дневного перерыва&lt;/div&gt;</description><Point><coordinates>101.6964976,3.1433850999999997,0</coordinates></Point></Placemark><Placemark><name>Thean Hou Temple</name><styleUrl>#kuala-lumpur-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Thean Hou Temple&lt;/b&gt;&lt;br&gt;Kuala Lumpur · 21 ноября&lt;br&gt;&lt;br&gt;Дневной храмовый визит после заселения, без чемоданов&lt;/div&gt;</description><Point><coordinates>101.6876678,3.1219525000000004,0</coordinates></Point></Placemark><Placemark><name>Wong Ah Wah, 1–9 Jalan Alor</name><styleUrl>#kuala-lumpur-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Wong Ah Wah, 1–9 Jalan Alor&lt;/b&gt;&lt;br&gt;Kuala Lumpur · 21 ноября&lt;br&gt;&lt;br&gt;Постоянный ресторан на Jalan Alor: крылышки и простой ужин&lt;/div&gt;</description><Point><coordinates>101.7079835,3.1449491999999997,0</coordinates></Point></Placemark><Placemark><name>BB Vintage: Dibuk, Old Town</name><styleUrl>#phuket-city</styleUrl><description>&lt;div&gt;&lt;b&gt;BB Vintage: Dibuk, Old Town&lt;/b&gt;&lt;br&gt;Phuket · 20 ноября&lt;br&gt;&lt;br&gt;Винтажный магазин на Dibuk в день Old Town, не полноценный рынок&lt;/div&gt;</description><Point><coordinates>98.3926948,7.8858823,0</coordinates></Point></Placemark><Placemark><name>Baan Rim Pa · Kalim</name><styleUrl>#phuket-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Baan Rim Pa · Kalim&lt;/b&gt;&lt;br&gt;Phuket · 25 ноября&lt;br&gt;&lt;br&gt;Рекомендуемый праздничный ужин с видом на бухту; стол и полный счёт пока не подтверждены&lt;/div&gt;</description><Point><coordinates>98.2841481,7.9165199,0</coordinates></Point></Placemark><Placemark><name>Baikingu Japanese Buffet Garden Restaurant: Wichit</name><styleUrl>#phuket-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Baikingu Japanese Buffet Garden Restaurant: Wichit&lt;/b&gt;&lt;br&gt;Phuket · 20 ноября&lt;br&gt;&lt;br&gt;Выбранный японский buffet именно в Wichit, ранний ужин перед КЛ&lt;/div&gt;</description><Point><coordinates>98.36739070000002,7.8728302999999995,0</coordinates></Point></Placemark><Placemark><name>Bang Tao