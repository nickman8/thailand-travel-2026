<kml xmlns="http://www.opengis.net/kml/2.2"><Document><name>Thailand itinerary 2026 — Phuket</name><Style id="bangkok-city"><IconStyle><color>ff4080ff</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/red-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff4080ff</color></LabelStyle></Style><Style id="bangkok-hotel"><IconStyle><color>ff00d5ff</color><scale>1.25</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff00d5ff</color></LabelStyle></Style><Style id="bangkok-alternative"><IconStyle><color>ff808080</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/grn-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff808080</color></LabelStyle></Style><Style id="phuket-city"><IconStyle><color>ff40a060</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/red-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff40a060</color></LabelStyle></Style><Style id="phuket-hotel"><IconStyle><color>ff00d5ff</color><scale>1.25</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff00d5ff</color></LabelStyle></Style><Style id="phuket-alternative"><IconStyle><color>ff808080</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/grn-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff808080</color></LabelStyle></Style><Style id="kuala-lumpur-city"><IconStyle><color>ffff8040</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/red-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ffff8040</color></LabelStyle></Style><Style id="kuala-lumpur-hotel"><IconStyle><color>ff00d5ff</color><scale>1.25</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff00d5ff</color></LabelStyle></Style><Style id="kuala-lumpur-alternative"><IconStyle><color>ff808080</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/grn-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff808080</color></LabelStyle></Style><Style id="tashkent-city"><IconStyle><color>ffb040a0</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/red-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ffb040a0</color></LabelStyle></Style><Style id="tashkent-hotel"><IconStyle><color>ff00d5ff</color><scale>1.25</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff00d5ff</color></LabelStyle></Style><Style id="tashkent-alternative"><IconStyle><color>ff808080</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/grn-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff808080</color></LabelStyle></Style><Style id="sochi-and-transit-city"><IconStyle><color>ff40c0d0</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/red-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff40c0d0</color></LabelStyle></Style><Style id="sochi-and-transit-hotel"><IconStyle><color>ff00d5ff</color><scale>1.25</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff00d5ff</color></LabelStyle></Style><Style id="sochi-and-transit-alternative"><IconStyle><color>ff808080</color><scale>1.0</scale><Icon><href>https://maps.google.com/mapfiles/kml/pushpin/grn-pushpin.png</href></Icon></IconStyle><LabelStyle><color>ff808080</color></LabelStyle></Style><Placemark><name>Amora Beach Resort Phuket</name><styleUrl>#phuket-hotel</styleUrl><description>&lt;div&gt;&lt;b&gt;Amora Beach Resort Phuket&lt;/b&gt;&lt;br&gt;Phuket · 19, 20, 21, 22, 23, 24, 25, 26, 27 ноября&lt;br&gt;&lt;br&gt;Наш отель по брони на 19–27 ноября; выезд 27 ноября. База у Bang Tao Beach. Фактически 21–22 ноября ночуем в Куала-Лумпуре в ExpressionZ; условия сохранения номера Amora на это время отдельно не подтверждены&lt;/div&gt;</description><Point><coordinates>98.2924771,7.991300099999999,0</coordinates></Point></Placemark><Placemark><name>Wyndham Garden Naithon Phuket</name><styleUrl>#phuket-hotel</styleUrl><description>&lt;div&gt;&lt;b&gt;Wyndham Garden Naithon Phuket&lt;/b&gt;&lt;br&gt;Phuket · 17, 18, 19 ноября&lt;br&gt;&lt;br&gt;Наш отель на 17–19 ноября; выезд 19 ноября. База у Naithon Beach на севере Пхукета&lt;/div&gt;</description><Point><coordinates>98.2798151,8.0585329,0</coordinates></Point></Placemark><Placemark><name>BB Vintage: Dibuk, Old Town</name><styleUrl>#phuket-city</styleUrl><description>&lt;div&gt;&lt;b&gt;BB Vintage: Dibuk, Old Town&lt;/b&gt;&lt;br&gt;Phuket · 20 ноября&lt;br&gt;&lt;br&gt;Винтажный магазин на Dibuk в день Old Town, не полноценный рынок&lt;/div&gt;</description><Point><coordinates>98.3926948,7.8858823,0</coordinates></Point></Placemark><Placemark><name>Baan Rim Pa · Kalim</name><styleUrl>#phuket-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Baan Rim Pa · Kalim&lt;/b&gt;&lt;br&gt;Phuket · 25 ноября&lt;br&gt;&lt;br&gt;Рекомендуемый праздничный ужин с видом на бухту; стол и полный счёт пока не подтверждены&lt;/div&gt;</description><Point><coordinates>98.2841481,7.9165199,0</coordinates></Point></Placemark><Placemark><name>Baikingu Japanese Buffet Garden Restaurant: Wichit</name><styleUrl>#phuket-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Baikingu Japanese Buffet Garden Restaurant: Wichit&lt;/b&gt;&lt;br&gt;Phuket · 20 ноября&lt;br&gt;&lt;br&gt;Выбранный японский buffet именно в Wichit, ранний ужин перед КЛ&lt;/div&gt;</description><Point><coordinates>98.36739070000002,7.8728302999999995,0</coordinates></Point></Placemark><Placemark><name>Bang Tao Beach у Amora: вечерний свет</name><styleUrl>#phuket-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Bang Tao Beach у Amora: вечерний свет&lt;/b&gt;&lt;br&gt;Phuket · 26 ноября&lt;br&gt;&lt;br&gt;Пляж у отеля Amora Beach Resort Phuket&lt;/div&gt;</description><Point><coordinates>98.2924771,7.991300099999999,0</coordinates></Point></Placemark><Placemark><name>Bangla Road, Patong</name><styleUrl>#phuket-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Bangla Road, Patong&lt;/b&gt;&lt;br&gt;Phuket · 19 ноября&lt;br&gt;&lt;br&gt;Короткая выбранная прогулка по ночному Patong: только по силам после отдыха&lt;/div&gt;</description><Point><coordinates>98.2968022,7.8935457,0</coordinates></Point></Placemark><Placemark><name>Big Buddha Phuket</name><styleUrl>#phuket-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Big Buddha Phuket&lt;/b&gt;&lt;br&gt;Phuket · 20 ноября&lt;br&gt;&lt;br&gt;Утренний визит на Nakkerd Hill при подтверждённом доступе и хорошей погоде&lt;/div&gt;</description><Point><coordinates>98.3133139,7.8274444,0</coordinates></Point></Placemark><Placemark><name>Boat Avenue / Cherngtalay: постоянные магазины</name><styleUrl>#phuket-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Boat Avenue / Cherngtalay: постоянные магазины&lt;/b&gt;&lt;br&gt;Phuket · 26 ноября&lt;br&gt;&lt;br&gt;Местные сувениры без дальнего возвращения в Old Town&lt;/div&gt;</description><Point><coordinates>98.3060991,7.9933835,0</coordinates></Point></Placemark><Placemark><name>Ma Doo Bua Café</name><styleUrl>#phuket-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Ma Doo Bua Café&lt;/b&gt;&lt;br&gt;Phuket · 23 ноября&lt;br&gt;&lt;br&gt;Кувшинки, настил и обед; платный фотограф/дрон требуют отдельного подтверждения&lt;/div&gt;</description><Point><coordinates>98.3285484,8.0219586,0</coordinates></Point></Placemark><Placemark><name>Naithon Beach Wooden Staircase / Wooden Bridge</name><styleUrl>#phuket-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Naithon Beach Wooden Staircase / Wooden Bridge&lt;/b&gt;&lt;br&gt;Phuket · 19 ноября&lt;br&gt;&lt;br&gt;Попутная лестница Naithon, если доступ и ступени безопасны&lt;/div&gt;</description><Point><coordinates>98.2783427,8.054535,0</coordinates></Point></Placemark><Placemark><name>One Chun Café &amp; Restaurant</name><styleUrl>#phuket-city</styleUrl><description>&lt;div&gt;&lt;b&gt;One Chun Café &amp; Restaurant&lt;/b&gt;&lt;br&gt;Phuket · 20 ноября&lt;br&gt;&lt;br&gt;Небольшой южнотайский обед перед вечерним Baikingu&lt;/div&gt;</description><Point><coordinates>98.39071229999999,7.8858087999999995,0</coordinates></Point></Placemark><Placemark><name>Phuket Elephant Care: Naithon Sanctuary</name><styleUrl>#phuket-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Phuket Elephant Care: Naithon Sanctuary&lt;/b&gt;&lt;br&gt;Phuket · 19 ноября&lt;br&gt;&lt;br&gt;Короткое кормление именно в Naithon перед выездом из Wyndham&lt;/div&gt;</description><Point><coordinates>98.2842008,8.0602652,0</coordinates></Point></Placemark><Placemark><name>Phuket Old Town</name><styleUrl>#phuket-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Phuket Old Town&lt;/b&gt;&lt;br&gt;Phuket · 20 ноября&lt;br&gt;&lt;br&gt;Thalang, Soi Rommanee и Dibuk: фасады, кафе и покупки в одном кластере&lt;/div&gt;</description><Point><coordinates>98.38979909999999,7.8847173,0</coordinates></Point></Placemark><Placemark><name>SUAY Cherngtalay: современная тайская кухня</name><styleUrl>#phuket-city</styleUrl><description>&lt;div&gt;&lt;b&gt;SUAY Cherngtalay: современная тайская кухня&lt;/b&gt;&lt;br&gt;Phuket · 23 ноября&lt;br&gt;&lt;br&gt;Необязательный современная тайская кухня ужин, не суши&lt;/div&gt;</description><Point><coordinates>98.3294234,7.9800865,0</coordinates></Point></Placemark><Placemark><name>TAKÉ Japanese Restaurant: Cherngtalay</name><styleUrl>#phuket-city</styleUrl><description>&lt;div&gt;&lt;b&gt;TAKÉ Japanese Restaurant: Cherngtalay&lt;/b&gt;&lt;br&gt;Phuket · 26 ноября&lt;br&gt;&lt;br&gt;Японский ужин рядом с Boat Avenue вместо отельного&lt;/div&gt;</description><Point><coordinates>98.3065706,7.9940537,0</coordinates></Point></Placemark><Placemark><name>Wat Kanan / วัดแขนน: белый храм Thalang</name><styleUrl>#phuket-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Wat Kanan / วัดแขนน: белый храм Thalang&lt;/b&gt;&lt;br&gt;Phuket · 23 ноября&lt;br&gt;&lt;br&gt;Белый храм над водой в Thalang, без подмены похожим названием&lt;/div&gt;</description><Point><coordinates>98.3463087,8.0364841,0</coordinates></Point></Placemark><Placemark><name>Пхи-Пхи и Майя Бэй: конкретный тур Sputnik 50276</name><styleUrl>#phuket-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Пхи-Пхи и Майя Бэй: конкретный тур Sputnik 50276&lt;/b&gt;&lt;br&gt;Phuket · 24 ноября&lt;br&gt;&lt;br&gt;Выбранные Phi Phi именно 24 ноября; насыщенный сборный морской день&lt;/div&gt;</description><Point><coordinates>98.7668425,7.6775891,0</coordinates></Point></Placemark></Document></kml>