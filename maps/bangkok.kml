dinates>100.59999800000001,13.707056999999999,0</coordinates></Point></Placemark><Placemark><name>Ramada Plaza by Wyndham Bangkok Sukhumvit 48</name><styleUrl>#bangkok-hotel</styleUrl><description>&lt;div&gt;&lt;b&gt;Ramada Plaza by Wyndham Bangkok Sukhumvit 48&lt;/b&gt;&lt;br&gt;Bangkok · 14, 15 ноября&lt;br&gt;&lt;br&gt;Наш отель на 14–15 ноября; выезд 15 ноября. База на Sukhumvit 48 в Бангкоке&lt;/div&gt;</description><Point><coordinates>100.598947,13.709149499999999,0</coordinates></Point></Placemark><Placemark><name>7-Eleven Festie Town at Happitat / The Forestias</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;7-Eleven Festie Town at Happitat / The Forestias&lt;/b&gt;&lt;br&gt;Bangkok ·  ноября&lt;br&gt;&lt;br&gt;Выбранный необычный магазин в Happitat, явно отложенный ради шопинга и винила&lt;/div&gt;</description><Point><coordinates>100.6657609,13.654651,0</coordinates></Point></Placemark><Placemark><name>Erawan Museum, Samut Prakan</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Erawan Museum, Samut Prakan&lt;/b&gt;&lt;br&gt;Bangkok · 14 ноября&lt;br&gt;&lt;br&gt;Необязательный музей в позднее утро прилёта, если есть силы&lt;/div&gt;</description><Point><coordinates>100.5891382,13.629975499999995,0</coordinates></Point></Placemark><Placemark><name>Bangkok Art and Culture Centre</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Bangkok Art and Culture Centre&lt;/b&gt;&lt;br&gt;Bangkok · 17 ноября&lt;br&gt;&lt;br&gt;Короткий выставочный визит перед Stolen Sala во вторник&lt;/div&gt;</description><Point><coordinates>100.53021679999999,13.746733899999999,0</coordinates></Point></Placemark><Placemark><name>Get Back and Jude Records</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Get Back and Jude Records&lt;/b&gt;&lt;br&gt;Bangkok · 16 ноября&lt;br&gt;&lt;br&gt;Винил в Chinatown по пути к Jeen и Song Wat&lt;/div&gt;</description><Point><coordinates>100.50756659999999,13.7384249,0</coordinates></Point></Placemark><Placemark><name>Hidden Bangkok Bistro</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Hidden Bangkok Bistro&lt;/b&gt;&lt;br&gt;Bangkok · 15 ноября&lt;br&gt;&lt;br&gt;Обед у канала с видом на Будду и красным автоматом открыток&lt;/div&gt;</description><Point><coordinates>100.4719368,13.721551400000001,0</coordinates></Point></Placemark><Placemark><name>Jeen Coffee Bar: Song Sawat</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Jeen Coffee Bar: Song Sawat&lt;/b&gt;&lt;br&gt;Bangkok · 16 ноября&lt;br&gt;&lt;br&gt;Кофе и красный автомат мини-открыток по пути&lt;/div&gt;</description><Point><coordinates>100.51118249999999,13.7388002,0</coordinates></Point></Placemark><Placemark><name>Mitr Street Tha Tien</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Mitr Street Tha Tien&lt;/b&gt;&lt;br&gt;Bangkok · 15 ноября&lt;br&gt;&lt;br&gt;Ранний ужин после Wat Pho с видом на этот храм&lt;/div&gt;</description><Point><coordinates>100.4916286,13.745205299999999,0</coordinates></Point></Placemark><Placemark><name>Museum Siam</name><styleUrl>#bangkok-alternative</styleUrl><description>&lt;div&gt;&lt;b&gt;Museum Siam&lt;/b&gt;&lt;br&gt;Bangkok · 15 ноября&lt;br&gt;&lt;br&gt;Музейная альтернатива части храмового дня&lt;/div&gt;</description><Point><coordinates>100.494137,13.744147000000002,0</coordinates></Point></Placemark><Placemark><name>Nai Ek Roll Noodles</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Nai Ek Roll Noodles&lt;/b&gt;&lt;br&gt;Bangkok · 16 ноября&lt;br&gt;&lt;br&gt;Постоянная лапшичная вместо обещания всех понедельничных тележек&lt;/div&gt;</description><Point><coordinates>100.5099369,13.7401053,0</coordinates></Point></Placemark><Placemark><name>Ojo Bangkok, The Standard Mahanakhon</name><styleUrl>#bangkok-alternative</styleUrl><description>&lt;div&gt;&lt;b&gt;Ojo Bangkok, The Standard Mahanakhon&lt;/b&gt;&lt;br&gt;Bangkok · 15 ноября&lt;br&gt;&lt;br&gt;Дорогой альтернативный ужин на высоте, не ещё один обязательный бар на крыше&lt;/div&gt;</description><Point><coordinates>100.5285357,13.7240573,0</coordinates></Point></Placemark><Placemark><name>Saen Saep: общественный катер</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Saen Saep: общественный катер&lt;/b&gt;&lt;br&gt;Bangkok · 16 ноября&lt;br&gt;&lt;br&gt;Короткий дешёвый городской канал Hua Chang → Pratunam перед centralwOrld&lt;/div&gt;</description><Point><coordinates>100.53071849999999,13.749193499999999,0</coordinates></Point></Placemark><Placemark><name>Song Wat Road</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Song Wat Road&lt;/b&gt;&lt;br&gt;Bangkok · 16 ноября&lt;br&gt;&lt;br&gt;Фасады и переулки до темноты по дороге от винила к Yaowarat&lt;/div&gt;</description><Point><coordinates>100.5089791,13.7373132,0</coordinates></Point></Placemark><Placemark><name>Space &amp; Time Cube+, Seacon Bangkae</name><styleUrl>#bangkok-alternative</styleUrl><description>&lt;div&gt;&lt;b&gt;Space &amp; Time Cube+, Seacon Bangkae&lt;/b&gt;&lt;br&gt;Bangkok · 15 ноября&lt;br&gt;&lt;br&gt;Крытая иммерсивная альтернатива западной части города&lt;/div&gt;</description><Point><coordinates>100.43522469999999,13.712141100000002,0</coordinates></Point></Placemark><Placemark><name>Stolen Sala</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Stolen Sala&lt;/b&gt;&lt;br&gt;Bangkok · 17 ноября&lt;br&gt;&lt;br&gt;Фиксированный обед 17-го и дневной вид на BTS&lt;/div&gt;</description><Point><coordinates>100.54621639999999,13.7432927,0</coordinates></Point></Placemark><Placemark><name>TAY Song Wat: возможный автомат мини-открыток</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;TAY Song Wat: возможный автомат мини-открыток&lt;/b&gt;&lt;br&gt;Bangkok · 16 ноября&lt;br&gt;&lt;br&gt;Необязательная проверка автомата по дороге Song Wat&lt;/div&gt;</description><Point><coordinates>100.5087166,13.7374619,0</coordinates></Point></Placemark><Placemark><name>Unculture Silom Rooftop Bar</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Unculture Silom Rooftop Bar&lt;/b&gt;&lt;br&gt;Bangkok · 14 ноября&lt;br&gt;&lt;br&gt;Возможный вечер огней после отдыха, не обязательный закат&lt;/div&gt;</description><Point><coordinates>100.5280185,13.7256334,0</coordinates></Point></Placemark><Placemark><name>Wat Arun</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Wat Arun&lt;/b&gt;&lt;br&gt;Bangkok · 15 ноября&lt;br&gt;&lt;br&gt;Фарфоровые детали прангов перед короткой переправой к Tha Tien&lt;/div&gt;</description><Point><coordinates>100.488444,13.743865200000002,0</coordinates></Point></Placemark><Placemark><name>Wat Paknam Phasi Charoen</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Wat Paknam Phasi Charoen&lt;/b&gt;&lt;br&gt;Bangkok · 15 ноября&lt;br&gt;&lt;br&gt;Полноценное посещение храма, а не только вид на Будду с воды&lt;/div&gt;</description><Point><coordinates>100.47035679999999,13.721791800000002,0</coordinates></Point></Placemark><Placemark><name>Wat Pho</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Wat Pho&lt;/b&gt;&lt;br&gt;Bangkok · 15 ноября&lt;br&gt;&lt;br&gt;Лежащий Будда и дворы; музейный зал условно внутри этого визита&lt;/div&gt;</description><Point><coordinates>100.4927733,13.746423700000001,0</coordinates></Point></Placemark><Placemark><name>Yaowarat / Chinatown: вечерняя прогулка</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Yaowarat / Chinatown: вечерняя прогулка&lt;/b&gt;&lt;br&gt;Bangkok · 16 ноября&lt;br&gt;&lt;br&gt;Вечерний неон Chinatown после Song Wat&lt;/div&gt;</description><Point><coordinates>100.5086601,13.7408333,0</coordinates></Point></Placemark><Placemark><name>centralwOrld: Uniqlo + Zara</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;centralwOrld: Uniqlo + Zara&lt;/b&gt;&lt;br&gt;Bangkok · 16 ноября&lt;br&gt;&lt;br&gt;Один ТЦ с нужными Uniqlo и Zara без лишней смены районов&lt;/div&gt;</description><Point><coordinates>100.53914879999999,13.746533699999999,0</coordinates></Point></Placemark><Placemark><name>Музейный зал внутри Wat Pho</name><styleUrl>#bangkok-city</styleUrl><description>&lt;div&gt;&lt;b&gt;Музейный зал внутри Wat Pho&lt;/b&gt;&lt;br&gt;Bangkok · 15 ноября&lt;br&gt;&lt;br&gt;Внутрихрамовый зал Wat Pho; использовать координаты комплекса Wat Pho&lt;/div&gt;</description><Point><coordinates>100.4927733,13.746423700000001,0</coordinates></Point></Placemark></Document></kml>