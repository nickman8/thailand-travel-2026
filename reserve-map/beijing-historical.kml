<?xml version='1.0' encoding='utf-8'?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Пекин — историческое</name>
    <Placemark id="lama-temple-yonghegong">
      <name>Храм Лам Юнхэгун</name>
      <description>&lt;b&gt;Храм Лам Юнхэгун&lt;/b&gt;&lt;br&gt;Не вошло в основной маршрут&lt;br&gt;Историческая подборка Пекина; не часть нынешней поездки.&lt;br&gt;Действующий тибето-буддийский монастырь: жёлтая черепица на красных стенах, курильницы с дымом благовоний, 18-метровый Майтрейя в павильоне Ваньфу.&lt;br&gt;Рейтинг: нет данных; дата оценки неизвестна.&lt;br&gt;&lt;a href="https://www.google.com/maps/place/data=!4m2!3m1!1s0x35f05334fde04cc5:0x5e6cb3b26525cbd0"&gt;Карточка на карте&lt;/a&gt;; дата: не указана&lt;br&gt;Координаты: build.load_places(): lama-temple-yonghegong</description>
      <Point>
        <coordinates>116.4172902,39.9476712,0</coordinates>
      </Point>
    </Placemark>
    <Placemark id="galaxy-soho">
      <name>Galaxy SOHO</name>
      <description>&lt;b&gt;Galaxy SOHO (Заха Хадид)&lt;/b&gt;&lt;br&gt;Не вошло в основной маршрут&lt;br&gt;Историческая подборка Пекина; не часть нынешней поездки.&lt;br&gt;Комплекс Захи Хадид: четыре слитых купола без прямых углов; 2 остановки от Dongzhimen.&lt;br&gt;Рейтинг: нет данных; дата оценки неизвестна.&lt;br&gt;&lt;a href="https://www.google.com/maps/place/data=!4m2!3m1!1s0x35f1acd869a17e8b:0x6d0c1a298ad85f29"&gt;Карточка на карте&lt;/a&gt;; дата: не указана&lt;br&gt;Координаты: build.load_places(): galaxy-soho</description>
      <Point>
        <coordinates>116.4332164,39.9214364,0</coordinates>
      </Point>
    </Placemark>
    <Placemark id="jin-ding-xuan-ditan">
