<?xml version='1.0' encoding='utf-8'?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Ташкент</name>
    <Placemark id="tashkent-metro">
      <name>Метро Ташкента</name>
      <description>&lt;b&gt;Метро Ташкента: станции Космонавтов и Алишер Навои&lt;/b&gt;&lt;br&gt;Не вошло в основной маршрут&lt;br&gt;Станции с космической и мозаичной отделкой; фото разрешены с июня 2018.&lt;br&gt;Рейтинг: нет данных; дата оценки неизвестна.&lt;br&gt;&lt;a href="https://www.google.com/maps/place/data=!4m2!3m1!1s0x38ae8b2020878009:0x90f60f5cf233ff60"&gt;Карточка на карте&lt;/a&gt;; дата: не указана&lt;br&gt;Координаты: build.load_places(): tashkent-metro</description>
      <Point>
        <coordinates>69.26477,41.305193,0</coordinates>
      </Point>
    </Placemark>
    <Placemark id="besh-qozon">
      <name>Центр плова «Беш Козон»</name>
      <description>&lt;b&gt;Центр плова «Беш Козон»&lt;/b&gt;&lt;br&gt;Не вошло в основной маршрут&lt;br&gt;Открытая кухня с казанами.&lt;br&gt;Рейтинг: нет данных; дата оценки неизвестна.&lt;br&gt;&lt;a href="https://www.google.com/maps/place/data=!4m2!3m1!1s0x38ae8caa88e053b7:0x802c70b70583f622"&gt;Карточка на карте&lt;/a&gt;; дата: не указана&lt;br&gt;Координаты: build.load_places(): besh-qozon</description>
      <Point>
        <coordinates>69.2854895,41.3475558,0</coordinates>
      </Point>
    </Placemark>
    <Placemark id="chorsu-bazaar">
      <name>Базар Чорсу</name>
      <description>&lt;b&gt;Базар Чорсу&lt;/b&gt;&lt;br&gt;Не вошло в основной маршрут&lt;br&gt;Рынок под зелёным куполом; сухофрукты, специи.&lt;br&gt;Рейтинг: нет данных; дата оценки неизвестна.&lt;br&gt;&lt;a href="https://www.google.com/maps/place/data=!4m2!3m1!1s0x38ae8b9cdd04953d:0xf8109d550917a88e"&gt;Карточка на карте&lt;/a&gt;; дата: не указана&lt;br&gt;Координаты: build.load_places(): chorsu-bazaar</description>
